# Maintainer: Andrew Sun <adsun701 at gmail dot com>

pkgname=libxls
pkgver=1.6.4
pkgrel=1
pkgdesc='Read binary Excel files from C/C++'
arch=('i686' 'x86_64')
url='https://github.com/libxls/libxls'
license=('BSD')
depends=('glibc')
source=("https://github.com/libxls/libxls/releases/download/v${pkgver}/$pkgname-$pkgver.tar.gz")
sha512sums=('4a57b04f311b26569e8863065f377392dbff9b4004c19ec31832edbc49e027a3561685b0e94615b3c6d5f0c3dca155493af73527faf1461bdd157490bda060ec')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    ./configure \
        --prefix=/usr \
        --enable-shared \
        --disable-static \
        --program-prefix=lib # fix conflict with catdoc package
    make
}

check() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    make check || true
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    make DESTDIR="${pkgdir}" install
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
